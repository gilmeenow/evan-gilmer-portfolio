# Anthropic credentials. Leave unset if you're logged in via `ant auth login`.
ANTHROPIC_API_KEY=

# OAuth bearer token for Robinhood's remote trading MCP server
# (https://agent.robinhood.com/mcp/trading). Obtain this per Robinhood's
# agent-trading platform documentation - it is separate from your
# Anthropic credentials and from Claude Code's own `claude mcp add` /
# `/mcp` interactive login (that flow authorizes an interactive Claude
# Code session, not a standalone script like this one).
ROBINHOOD_MCP_TOKEN=

# Optional overrides
# TRADING_AGENT_MODEL=claude-opus-5
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# TRADING_AGENT_STATE_DIR=.state
